# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*
!.env.example

# Local agent working notes (memory logs, snapshots). Never part of the repo — this is the same
# directory `.vercelignore` excludes from deployments, and it was previously only excluded there.
.workbuddy-ai

# Kanban worker worktrees. Each spawned worker gets its own checkout and branch under here, so
# parallel workers cannot collide on the same files. Never commit — the contents are other branches.
.worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
